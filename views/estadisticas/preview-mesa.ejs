<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: 'Previsualizar mesa eliminada - CODEBYTES' }) %>
</head>
<body class="bg-slate-100">
  <%- include('../partials/topbar', { user }) %>
  <div class="flex pt-16 min-h-screen">
    <%- include('../partials/sidebar', { user, activo: 'estadisticas' }) %>

    <div class="flex-1 flex flex-col min-w-0 min-h-[calc(100vh-4rem)] lg:ml-64">
      <main class="p-5 flex-1 w-full max-w-3xl">
        <div class="bg-white rounded-lg shadow-sm px-5 py-4 flex flex-wrap justify-between items-start gap-2 mb-5">
          <div>
            <h1 class="text-xl font-bold text-slate-800"><%= reserva.nomesa %></h1>
            <p class="text-slate-500 text-sm mt-1"><%= reserva.zona %> · Mesero: <%= reserva.mesero %></p>
          </div>
          <nav class="text-sm text-slate-500 flex items-center gap-2 flex-wrap">
            <a href="/estadisticas" class="text-sky-600 hover:underline"><i class="fa-solid fa-house"></i> Estadísticas</a>
            <i class="fa-solid fa-chevron-right text-xs"></i> Mesa eliminada
          </nav>
        </div>

        <div class="bg-sky-50 text-sky-800 rounded-lg px-4 py-2.5 mb-5 flex items-center gap-2 text-sm">
          <i class="fa-solid fa-eye"></i> Solo previsualización del contenido que tenía la mesa al momento de eliminarse.
        </div>

        <div class="bg-white rounded-lg shadow-sm px-5 py-3 text-sm text-slate-600 border-l-4 border-rose-500 mb-5">
          <strong>Eliminada:</strong> <%= new Date(reserva.fecha).toLocaleString('es-HN') %><br>
          <strong>Motivo:</strong> <%= reserva.razon %>
        </div>

        <% if (cuentas.length === 0) { %>
          <p class="text-slate-500">Esta mesa no tenía cuentas registradas.</p>
        <% } %>

        <% cuentas.forEach((c) => { %>
          <section class="bg-white rounded-lg shadow-sm p-5 mb-5">
            <h2 class="text-lg font-semibold flex items-center gap-2 mb-3">
              <i class="fa-solid fa-clipboard-list text-sky-600"></i> Cuenta → <%= c.nombrecuenta %>
            </h2>
            <% if (c.pedido.lineas.length === 0) { %>
              <p class="text-slate-500 text-sm">Sin productos.</p>
            <% } else { %>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[420px] border-collapse text-sm">
                  <thead>
                    <tr class="text-left text-slate-500">
                      <th class="py-2 pr-2">Producto</th><th class="py-2 pr-2">Cant.</th>
                      <th class="py-2 pr-2">Precio</th><th class="py-2 pr-2">Nota</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% c.pedido.lineas.forEach((l) => { %>
                      <tr class="border-t border-slate-100">
                        <td class="py-2 pr-2"><%= l.producto %><% if (l.cortesia) { %> (cortesía)<% } %></td>
                        <td class="py-2 pr-2"><%= l.cantidad %></td>
                        <td class="py-2 pr-2"><%= l.precio.toFixed(2) %></td>
                        <td class="py-2 pr-2"><%= l.nota %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="mt-3 text-sm text-right">
                <strong class="text-base">Total: <%= c.pedido.total.toFixed(2) %></strong>
              </p>
            <% } %>
          </section>
        <% }) %>

        <a href="/estadisticas"
          class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300
                 text-sm font-medium rounded-md px-4 py-2">
          <i class="fa-solid fa-arrow-left"></i> Regresar
        </a>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <%- include('../partials/layout-scripts') %>
</body>
</html>
