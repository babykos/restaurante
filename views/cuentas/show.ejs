<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: cuenta.nombrecuenta + ' - CODEBYTES' }) %>
</head>
<body class="bg-slate-100">
  <%- include('../partials/topbar', { user }) %>
  <div class="flex pt-16 min-h-screen">
    <%- include('../partials/sidebar', { user, activo: 'mesas' }) %>

    <div class="flex-1 flex flex-col min-w-0 min-h-[calc(100vh-4rem)] lg:ml-64">
      <main class="p-5 flex-1 w-full max-w-3xl">
        <div class="bg-white rounded-lg shadow-sm px-5 py-4 flex flex-wrap justify-between items-start gap-2 mb-5">
          <div>
            <h1 class="text-xl font-bold text-slate-800"><%= cuenta.nomesa %> — <%= cuenta.nombrecuenta %></h1>
            <p class="text-slate-500 text-sm mt-1">
              <%= cuenta.zona %><% if (cuenta.enviadacaja) { %> · Enviada a caja<% } %>
            </p>
          </div>
          <nav class="text-sm text-slate-500 flex items-center gap-2 flex-wrap">
            <a href="/mesas" class="text-sky-600 hover:underline"><i class="fa-solid fa-house"></i> Home</a>
            <i class="fa-solid fa-chevron-right text-xs"></i>
            <a href="/mesas/<%= cuenta.mesaid %>/cuentas" class="text-sky-600 hover:underline">Cuentas</a>
            <i class="fa-solid fa-chevron-right text-xs"></i> <%= cuenta.nombrecuenta %>
          </nav>
        </div>

        <% if (typeof flash !== 'undefined' && flash) { %>
          <div id="flash-banner" class="bg-emerald-100 text-emerald-800 rounded-lg px-4 py-3 mb-5 flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> <%= flash.mensaje %>
          </div>
        <% } %>

        <% if (bloqueada) { %>
          <div class="bg-amber-100 text-amber-800 rounded-lg px-5 py-4 mb-5">
            <p class="flex items-center gap-2">
              <i class="fa-solid fa-circle-exclamation"></i>
              Esta cuenta ya no admite cambios (facturada, inactiva o enviada a caja).
            </p>
            <a href="/mesas/<%= cuenta.mesaid %>/cuentas"
              class="inline-flex items-center gap-2 bg-white hover:bg-amber-50 text-amber-800 border border-amber-300
                     text-sm font-medium rounded-md px-4 py-2 mt-3">
              <i class="fa-solid fa-arrow-left"></i> Regresar
            </a>
          </div>
        <% } else { %>
        <section class="bg-white rounded-lg shadow-sm p-5 mb-5 text-center">
          <p class="text-slate-500 text-sm">Cargarás pedidos a la cuenta de</p>
          <p class="text-xl font-bold text-slate-800 mb-3"><%= cuenta.nombrecuenta %></p>
          <a href="/mesas/<%= cuenta.mesaid %>/cuentas"
            class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700
                   text-sm font-medium rounded-md px-4 py-2.5">
            <i class="fa-solid fa-chair"></i> Regresar a la mesa
          </a>
        </section>

        <section class="bg-white rounded-lg shadow-sm p-5 mb-5">
          <div class="overflow-x-auto mb-4">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-slate-500 border-b border-slate-200">
                  <th class="py-2 pr-2">Cant.</th><th class="py-2 pr-2">Producto</th>
                  <th class="py-2 pr-2">Total</th><th class="py-2 pr-2 w-10">Acc</th>
                </tr>
              </thead>
              <tbody id="carrito">
                <tr id="carrito-vacio">
                  <td colspan="4" class="py-4 text-center text-slate-400">No hay datos disponibles para la consulta</td>
                </tr>
              </tbody>
            </table>
          </div>

          <form id="form-pedido" method="POST" action="/cuentas/<%= cuenta.cuentamesaid %>/pedido">
            <input type="hidden" name="items" id="items-input">
            <label class="block text-sm my-2">
              Comentarios
              <input type="text" name="comentarios" class="block w-full border border-slate-300 rounded-md px-2 py-1.5 mt-1">
            </label>
            <label class="flex items-center gap-2 text-sm my-2">
              <input type="checkbox" name="llevar" value="1"> Para llevar
            </label>
            <button type="submit" id="btn-enviar-pedido" disabled
              class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 disabled:bg-slate-400
                     disabled:cursor-not-allowed hover:bg-emerald-700 text-white text-sm font-medium rounded-md py-3">
              <i class="fa-solid fa-fire-burner"></i> Realizar pedido a cocina
            </button>
          </form>
        </section>

        <section class="bg-white rounded-lg shadow-sm overflow-hidden mb-5">
          <button type="button" id="btn-inicio-categoria"
            class="w-full bg-slate-800 hover:bg-slate-700 text-white text-sm font-medium py-3 hidden">
            <i class="fa-solid fa-arrow-left"></i> Inicio Categoría
          </button>
          <div id="categorias-grid" class="grid grid-cols-2 gap-3 p-4"></div>
          <div id="productos-grid" class="grid grid-cols-2 gap-3 p-4 hidden"></div>
        </section>

        <dialog id="dialog-variantes"
          class="fixed inset-0 m-auto h-fit w-full max-w-md rounded-lg shadow-lg p-0 border-0 backdrop:bg-slate-900/50">
          <div class="p-5 flex flex-col gap-3">
            <h2 class="text-sm font-bold text-slate-800">Variantes del producto</h2>
            <div id="lista-variantes" class="grid grid-cols-2 gap-2 max-h-56 overflow-y-auto"></div>
            <label class="block text-sm">
              Nota / descripción
              <textarea id="descripcion-variante" rows="2"
                class="block w-full border border-slate-300 rounded-md px-2 py-1.5 mt-1 text-sm"></textarea>
            </label>
            <div class="flex justify-end gap-2 mt-1">
              <button type="button" onclick="document.getElementById('dialog-variantes').close()"
                class="text-slate-600 hover:bg-slate-100 text-sm font-medium rounded-md px-3 py-2">
                Cancelar
              </button>
              <button type="button" id="btn-aplicar-descripcion"
                class="bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium rounded-md px-3 py-2">
                Aplicar
              </button>
            </div>
          </div>
        </dialog>

        <dialog id="dialog-asistente"
          class="fixed inset-0 m-auto h-fit w-full max-w-lg rounded-lg shadow-lg p-0 border-0 backdrop:bg-slate-900/50">
          <div class="flex flex-col max-h-[85vh] min-h-0">
            <div class="p-5 pb-3 shrink-0 flex items-start justify-between gap-3">
              <div>
                <h2 id="asistente-nombre" class="text-lg font-bold text-slate-800"></h2>
                <p id="asistente-precio-base" class="text-sm text-slate-500"></p>
                <p id="asistente-paso" class="text-xs text-sky-600 font-medium mt-1"></p>
              </div>
              <button type="button" onclick="document.getElementById('dialog-asistente').close()"
                class="text-slate-400 hover:text-slate-600 text-xl leading-none px-1" aria-label="Cerrar">
                &times;
              </button>
            </div>
            <div id="asistente-grupos" class="px-5 overflow-y-auto flex-1 min-h-0 flex flex-col gap-3"></div>
            <div class="p-5 pt-3 border-t border-slate-200 flex items-center justify-between gap-3 shrink-0">
              <span id="asistente-total" class="text-base font-bold text-slate-800"></span>
              <div class="flex gap-2">
                <button type="button" id="btn-atras-asistente"
                  class="text-slate-600 hover:bg-slate-100 text-sm font-medium rounded-md px-3 py-2">
                  Atrás
                </button>
                <button type="button" id="btn-siguiente-asistente"
                  class="bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium rounded-md px-4 py-2">
                  Siguiente
                </button>
              </div>
            </div>
          </div>
        </dialog>
        <% } %>

        <section class="bg-white rounded-lg shadow-sm p-5 mb-5">
          <h2 class="text-lg font-semibold flex items-center gap-2 mb-3">
            <i class="fa-solid fa-clipboard-list text-sky-600"></i> Pedido
          </h2>
          <% if (pedido.lineas.length === 0) { %>
            <p class="text-slate-500">Sin productos todavía.</p>
          <% } else { %>
            <div class="hidden sm:block overflow-x-auto">
              <table class="w-full min-w-[480px] border-collapse text-sm">
                <thead>
                  <tr class="text-left text-slate-500">
                    <th class="py-2 pr-2">#Pedido</th><th class="py-2 pr-2">Producto</th>
                    <th class="py-2 pr-2">Cant.</th><th class="py-2 pr-2">Precio</th>
                    <th class="py-2 pr-2">ISV%</th><th class="py-2 pr-2">Nota</th>
                  </tr>
                </thead>
                <tbody>
                  <% pedido.lineas.forEach((l) => { %>
                    <tr class="border-t border-slate-100">
                      <td class="py-2 pr-2"><%= l.nopedido %></td>
                      <td class="py-2 pr-2"><%= l.producto %><% if (l.cortesia) { %> (cortesía)<% } %></td>
                      <td class="py-2 pr-2"><%= l.cantidad %></td>
                      <td class="py-2 pr-2"><%= l.precio.toFixed(2) %></td>
                      <td class="py-2 pr-2"><%= l.porcentajeisv %></td>
                      <td class="py-2 pr-2"><%= l.nota %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div class="sm:hidden flex flex-col gap-3">
              <% pedido.lineas.forEach((l) => { %>
                <div class="border border-slate-200 rounded-md p-3">
                  <div class="flex justify-between items-start gap-2">
                    <span class="font-semibold text-sm text-slate-800">
                      <%= l.producto %><% if (l.cortesia) { %> (cortesía)<% } %>
                    </span>
                    <span class="text-xs text-slate-400 whitespace-nowrap">#<%= l.nopedido %></span>
                  </div>
                  <div class="mt-2 grid grid-cols-3 gap-2 text-xs">
                    <div><span class="block text-slate-400">Cant.</span><%= l.cantidad %></div>
                    <div><span class="block text-slate-400">Precio</span><%= l.precio.toFixed(2) %></div>
                    <div><span class="block text-slate-400">ISV%</span><%= l.porcentajeisv %></div>
                  </div>
                  <% if (l.nota) { %>
                    <p class="mt-2 text-xs text-slate-500"><span class="text-slate-400">Nota:</span> <%= l.nota %></p>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <p class="mt-3 text-sm">
              Subtotal: <%= pedido.subtotal.toFixed(2) %> —
              Impuesto: <%= pedido.impuesto.toFixed(2) %> —
              <strong class="text-base">Total: <%= pedido.total.toFixed(2) %></strong>
            </p>
          <% } %>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <%- include('../partials/layout-scripts') %>
  <script>
    const flashBanner = document.getElementById('flash-banner');
    if (flashBanner) {
      setTimeout(() => flashBanner.remove(), 4000);
    }

    const productos = <%- JSON.stringify(typeof productos !== 'undefined' ? productos : []) %>;
    const categoriasArbol = <%- JSON.stringify(typeof categoriasArbol !== 'undefined' ? categoriasArbol : []) %>;
    const variantesProductos = <%- JSON.stringify(typeof variantesProductos !== 'undefined' ? variantesProductos : []) %>;
    const asistentesProductos = <%- JSON.stringify(typeof asistentesProductos !== 'undefined' ? asistentesProductos : {}) %>;
    const carrito = [];
    const SEPARADOR_VARIANTE = '>>';
    let filaEditandoDescripcion = null;

    const carritoBody = document.getElementById('carrito');
    const itemsInput = document.getElementById('items-input');
    const btnEnviar = document.getElementById('btn-enviar-pedido');

    const dialogVariantes = document.getElementById('dialog-variantes');
    const listaVariantes = document.getElementById('lista-variantes');
    const inputDescripcionVariante = document.getElementById('descripcion-variante');

    function abrirModalDescripcion(idx) {
      filaEditandoDescripcion = idx;
      const item = carrito[idx];
      inputDescripcionVariante.value = item.descripcion || '';

      const opciones = variantesProductos.filter((v) => v.grupoid === item.grupoid);
      listaVariantes.innerHTML = '';
      if (opciones.length === 0) {
        listaVariantes.innerHTML = '<p class="col-span-2 text-slate-400 text-sm">Este producto no tiene variantes.</p>';
      } else {
        opciones.forEach((v) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm rounded-md px-3 py-2 text-left';
          btn.textContent = v.variante;
          btn.addEventListener('click', () => {
            const actual = inputDescripcionVariante.value;
            inputDescripcionVariante.value = actual ? `${actual} ${SEPARADOR_VARIANTE} ${v.variante}` : v.variante;
          });
          listaVariantes.appendChild(btn);
        });
      }

      dialogVariantes.showModal();
    }

    document.getElementById('btn-aplicar-descripcion').addEventListener('click', () => {
      if (filaEditandoDescripcion !== null) {
        const item = carrito[filaEditandoDescripcion];
        const nuevaDescripcion = inputDescripcionVariante.value.trim();
        if (item.cantidad > 1 && nuevaDescripcion) {
          // PROVISIONAL: la fila agrupa varias unidades. Se separa una a su propia fila
          // personalizada para no forzar la misma personalizacion al resto.
          item.cantidad -= 1;
          carrito.splice(filaEditandoDescripcion + 1, 0, { ...item, cantidad: 1, descripcion: nuevaDescripcion });
        } else {
          item.descripcion = nuevaDescripcion;
        }
        renderCarrito();
      }
      dialogVariantes.close();
    });

    function renderCarrito() {
      carritoBody.innerHTML = '';
      if (carrito.length === 0) {
        carritoBody.innerHTML = '<tr><td colspan="4" class="py-4 text-center text-slate-400">No hay datos disponibles para la consulta</td></tr>';
      }
      carrito.forEach((item, idx) => {
        const tr = document.createElement('tr');
        tr.className = 'border-t border-slate-100';
        const esAsistente = Array.isArray(item.opcionids) && item.opcionids.length > 0;
        const nombreHtml = esAsistente
          ? `<span class="text-slate-800">${item.producto}</span>`
          : `<a href="#" class="producto-link text-slate-800 hover:text-sky-600 hover:underline">${item.producto}</a>`;
        tr.innerHTML = `
          <td class="py-1.5 pr-2">${item.cantidad}</td>
          <td class="py-1.5 pr-2">
            ${nombreHtml}
            ${item.descripcion ? `<div class="text-xs text-slate-400">${item.descripcion}</div>` : ''}
          </td>
          <td class="py-1.5 pr-2">${(item.cantidad * item.precio).toFixed(2)}</td>
          <td class="py-1.5 pr-2"></td>
        `;
        if (!esAsistente) {
          tr.querySelector('.producto-link').addEventListener('click', (e) => {
            e.preventDefault();
            abrirModalDescripcion(idx);
          });
        }
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'text-rose-600 hover:text-rose-800';
        btn.innerHTML = '<i class="fa-solid fa-trash"></i>';
        btn.onclick = () => { carrito.splice(idx, 1); renderCarrito(); };
        tr.lastElementChild.appendChild(btn);
        carritoBody.appendChild(tr);
      });
      itemsInput.value = JSON.stringify(
        carrito.map(({ productoid, cantidad, descripcion, opcionids }) => ({ productoid, cantidad, descripcion, opcionids }))
      );
      btnEnviar.disabled = carrito.length === 0;
    }

    document.getElementById('form-pedido').addEventListener('submit', (e) => {
      const cantidadTotal = carrito.reduce((n, i) => n + i.cantidad, 0);
      if (!confirm(`¿Confirmás enviar ${cantidadTotal} producto(s) a cocina?`)) {
        e.preventDefault();
      }
    });

    function moneyL(n) {
      return 'L ' + Number(n).toFixed(2);
    }

    const dialogAsistente = document.getElementById('dialog-asistente');
    const asistenteNombreEl = document.getElementById('asistente-nombre');
    const asistentePrecioBaseEl = document.getElementById('asistente-precio-base');
    const asistentePasoEl = document.getElementById('asistente-paso');
    const asistenteGruposEl = document.getElementById('asistente-grupos');
    const asistenteTotalEl = document.getElementById('asistente-total');
    const btnAtrasAsistente = document.getElementById('btn-atras-asistente');
    const btnSiguienteAsistente = document.getElementById('btn-siguiente-asistente');

    let asistenteActual = null; // { producto, grupos, paso, seleccion: Map<grupoid, Set<productoid>> }

    function abrirAsistente(producto) {
      const grupos = asistentesProductos[producto.productoid] || [];
      const seleccion = new Map();
      grupos.forEach((g) => seleccion.set(g.grupoid, new Set()));

      asistenteActual = { producto, grupos, paso: 0, seleccion };

      asistenteNombreEl.textContent = producto.producto;
      asistentePrecioBaseEl.textContent = 'Precio base: ' + moneyL(producto.precioventa);

      renderPasoAsistente();
      dialogAsistente.showModal();
    }

    function renderPasoAsistente() {
      const { grupos, paso, seleccion } = asistenteActual;
      const grupo = grupos[paso];

      asistentePasoEl.textContent = grupos.length > 1 ? `Paso ${paso + 1} de ${grupos.length}` : '';
      asistenteGruposEl.innerHTML = '';

      if (grupo) {
        asistenteGruposEl.appendChild(construirPanelGrupo(grupo, seleccion.get(grupo.grupoid)));
      }

      btnAtrasAsistente.classList.toggle('invisible', paso === 0);
      btnSiguienteAsistente.textContent = paso === grupos.length - 1 ? 'Confirmar' : 'Siguiente';

      recalcularTotalAsistente();
    }

    function construirPanelGrupo(grupo, seleccionGrupo) {
      const panel = document.createElement('div');
      panel.className = 'border border-slate-200 rounded-md overflow-hidden';

      const cabecera = document.createElement('div');
      cabecera.className = 'flex items-center justify-between px-3 py-2 bg-slate-50 border-b border-slate-200';

      const nombreGrupo = document.createElement('span');
      nombreGrupo.className = 'text-sm font-semibold text-slate-700';
      nombreGrupo.textContent = grupo.grupo;

      const infoDer = document.createElement('div');
      infoDer.className = 'flex items-center gap-2 text-xs';
      if (grupo.obligatorio) {
        const req = document.createElement('span');
        req.className = 'text-rose-600 font-semibold';
        req.textContent = 'Requerido';
        infoDer.appendChild(req);
      }
      const tipoSel = document.createElement('span');
      tipoSel.className = 'text-slate-400';
      tipoSel.textContent = grupo.seleccionMaxima === 1 ? 'Elige 1' : `Elige hasta ${grupo.seleccionMaxima}`;
      infoDer.appendChild(tipoSel);

      cabecera.appendChild(nombreGrupo);
      cabecera.appendChild(infoDer);
      panel.appendChild(cabecera);

      const lista = document.createElement('div');
      lista.className = 'grid grid-cols-1 sm:grid-cols-2';

      grupo.opciones.forEach((opcion) => {
        const fila = document.createElement('label');
        fila.className = 'flex items-center justify-between gap-2 px-3 py-2 cursor-pointer hover:bg-slate-50 border-t border-slate-100';

        const nombreOpcion = document.createElement('span');
        nombreOpcion.className = 'text-sm text-slate-700';
        nombreOpcion.textContent = opcion.producto;

        const derecha = document.createElement('div');
        derecha.className = 'flex items-center gap-2 shrink-0';

        if (opcion.precioadicional > 0) {
          const precioSpan = document.createElement('span');
          precioSpan.className = 'text-xs text-slate-500';
          precioSpan.textContent = '+' + moneyL(opcion.precioadicional);
          derecha.appendChild(precioSpan);
        }

        const control = document.createElement('input');
        control.type = grupo.seleccionMaxima === 1 ? 'radio' : 'checkbox';
        control.name = 'asistente-grupo-' + grupo.grupoid;
        control.className = 'w-4 h-4';
        control.checked = seleccionGrupo.has(opcion.productoid);

        control.addEventListener('change', () => {
          if (control.type === 'radio') {
            seleccionGrupo.clear();
            seleccionGrupo.add(opcion.productoid);
          } else if (control.checked) {
            if (seleccionGrupo.size >= grupo.seleccionMaxima) {
              control.checked = false;
              alert(`Solo puedes elegir hasta ${grupo.seleccionMaxima} opciones en "${grupo.grupo}"`);
              return;
            }
            seleccionGrupo.add(opcion.productoid);
          } else {
            seleccionGrupo.delete(opcion.productoid);
          }
          recalcularTotalAsistente();
        });

        derecha.appendChild(control);
        fila.appendChild(nombreOpcion);
        fila.appendChild(derecha);
        lista.appendChild(fila);
      });

      panel.appendChild(lista);
      return panel;
    }

    function recalcularTotalAsistente() {
      if (!asistenteActual) return;
      let extras = 0;
      asistenteActual.grupos.forEach((grupo) => {
        const seleccionGrupo = asistenteActual.seleccion.get(grupo.grupoid);
        grupo.opciones.forEach((opcion) => {
          if (seleccionGrupo.has(opcion.productoid)) {
            extras += Number(opcion.precioadicional);
          }
        });
      });
      const total = Number(asistenteActual.producto.precioventa) + extras;
      asistenteTotalEl.textContent = 'Total: ' + moneyL(total);
    }

    btnAtrasAsistente.addEventListener('click', () => {
      if (asistenteActual && asistenteActual.paso > 0) {
        asistenteActual.paso -= 1;
        renderPasoAsistente();
      }
    });

    btnSiguienteAsistente.addEventListener('click', () => {
      if (!asistenteActual) return;
      const { grupos, paso, seleccion } = asistenteActual;
      const grupoActual = grupos[paso];

      if (grupoActual.obligatorio && seleccion.get(grupoActual.grupoid).size === 0) {
        alert(`Debes seleccionar al menos una opción en "${grupoActual.grupo}"`);
        return;
      }

      if (paso < grupos.length - 1) {
        asistenteActual.paso += 1;
        renderPasoAsistente();
        return;
      }

      const seleccionadas = [];
      for (const grupo of grupos) {
        for (const opcion of grupo.opciones) {
          if (seleccion.get(grupo.grupoid).has(opcion.productoid)) {
            seleccionadas.push(opcion);
          }
        }
      }

      const extras = seleccionadas.reduce((n, o) => n + Number(o.precioadicional), 0);
      const precioTotal = Number(asistenteActual.producto.precioventa) + extras;

      carrito.push({
        productoid: asistenteActual.producto.productoid,
        producto: asistenteActual.producto.producto,
        precio: precioTotal,
        cantidad: 1,
        descripcion: seleccionadas.map((o) => o.producto).join(', '),
        opcionids: seleccionadas.map((o) => o.productoid),
      });
      renderCarrito();

      dialogAsistente.close();
      mostrarToast(`Agregado: ${asistenteActual.producto.producto}`);
    });

    function mostrarToast(mensaje) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-5 left-1/2 -translate-x-1/2 bg-emerald-600 text-white text-sm font-medium ' +
        'rounded-lg px-6 py-3 shadow-lg z-50 flex items-center justify-center gap-2 opacity-0 transition-opacity ' +
        'duration-200 w-[90vw] max-w-md';
      toast.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${mensaje}`;
      document.body.appendChild(toast);
      requestAnimationFrame(() => { toast.style.opacity = '1'; });
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 200);
      }, 1800);
    }

    function destellarBoton(btn) {
      const bgOriginal = btn.style.backgroundColor;
      const colorOriginal = btn.style.color;
      btn.style.transition = 'background-color 0.15s, color 0.15s';
      btn.style.backgroundColor = '#059669';
      btn.style.color = '#ffffff';
      setTimeout(() => {
        btn.style.backgroundColor = bgOriginal;
        btn.style.color = colorOriginal;
      }, 300);
    }

    function agregarAlCarrito(p) {
      // Solo se agrupa en una fila existente si esa fila todavia no fue personalizada.
      // Apenas una fila tiene variantes/nota, la siguiente unidad entra en su propia fila
      // para poder personalizarla aparte.
      const existente = carrito.find((i) => i.productoid === p.productoid && !i.descripcion);
      if (existente) {
        existente.cantidad += 1;
      } else {
        carrito.push({
          productoid: p.productoid,
          producto: p.producto,
          precio: Number(p.precioventa),
          cantidad: 1,
          grupoid: p.grupoid,
          descripcion: '',
        });
      }
      renderCarrito();
    }

    const categoriasGrid = document.getElementById('categorias-grid');
    const productosGrid = document.getElementById('productos-grid');
    const btnInicioCategoria = document.getElementById('btn-inicio-categoria');

    const hijosPorPadre = new Map();
    categoriasArbol.forEach((c) => {
      const clave = c.padre === null ? 'raiz' : c.padre;
      if (!hijosPorPadre.has(clave)) hijosPorPadre.set(clave, []);
      hijosPorPadre.get(clave).push(c);
    });

    let pilaCategorias = [];

    function crearBotonProducto(p) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bg-sky-50 hover:bg-sky-100 text-sky-900 border border-sky-200 text-sm font-medium rounded-md py-3 px-2';
      btn.textContent = `${p.producto} — ${Number(p.precioventa).toFixed(2)}`;
      btn.addEventListener('click', () => {
        if (p.esAsistente) {
          abrirAsistente(p);
        } else {
          agregarAlCarrito(p);
          destellarBoton(btn);
          mostrarToast(`Agregado: ${p.producto}`);
        }
      });
      return btn;
    }

    function crearBotonCategoria(c) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bg-sky-400 hover:bg-sky-500 text-white text-sm font-medium rounded-md py-4 px-2';
      btn.textContent = c.categoria;
      btn.addEventListener('click', () => {
        pilaCategorias.push(c);
        renderNivel();
      });
      return btn;
    }

    function renderNivel() {
      const actual = pilaCategorias[pilaCategorias.length - 1] || null;
      const hijos = hijosPorPadre.get(actual ? actual.categoriaid : 'raiz') || [];
      const productosDelNivel = actual ? productos.filter((p) => p.categoriaid === actual.categoriaid) : [];

      categoriasGrid.innerHTML = '';
      hijos.forEach((c) => categoriasGrid.appendChild(crearBotonCategoria(c)));
      categoriasGrid.classList.toggle('hidden', hijos.length === 0);

      productosGrid.innerHTML = '';
      productosDelNivel.forEach((p) => productosGrid.appendChild(crearBotonProducto(p)));
      productosGrid.classList.toggle('hidden', productosDelNivel.length === 0);

      if (actual) {
        btnInicioCategoria.classList.remove('hidden');
        btnInicioCategoria.innerHTML = `<i class="fa-solid fa-arrow-left"></i> ${actual.categoria}`;
      } else {
        btnInicioCategoria.classList.add('hidden');
      }
    }

    btnInicioCategoria.addEventListener('click', () => {
      pilaCategorias.pop();
      renderNivel();
    });

    renderNivel();
  </script>
</body>
</html>
