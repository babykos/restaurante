<article class="bg-white rounded-lg shadow-sm border-t-4 border-sky-500">
  <header class="px-4 py-2.5 font-bold text-sm border-b border-slate-100"><%= m.nomesa %></header>
  <div class="p-4 flex items-center gap-3 flex-wrap">
    <img src="/images/mesa.png" alt="" class="w-12 h-12 object-contain <%= m.estado !== 'libre' ? 'grayscale-[40%]' : '' %>">
    <div class="flex-1 min-w-[110px] flex flex-col text-xs gap-0.5">
      <% if (m.estado === 'libre') { %>
        <strong class="text-emerald-600 flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check"></i> MESA DISPONIBLE
        </strong>
        <span class="text-slate-500">Mesero: Disponible</span>
      <% } else { %>
        <% const color = m.estado === 'mia' ? 'text-sky-600' : 'text-rose-600'; %>
        <strong class="<%= color %> flex items-center gap-1.5">
          <i class="fa-solid fa-lock"></i> MESA OCUPADA
        </strong>
        <span class="text-slate-500">Mesero: <%= m.dueno %></span>
        <% if (m.cuentas) { %>
          <span class="text-slate-500"><i class="fa-solid fa-receipt"></i> <%= m.cuentas %></span>
        <% } %>
      <% } %>
    </div>
    <% if (m.estado === 'libre') { %>
      <button type="button"
        class="w-full bg-sky-600 hover:bg-sky-700 text-white text-xs font-medium rounded px-3 py-1.5"
        onclick="const d=document.getElementById('dialog-abrir-<%= m.mesaid %>'); d.querySelector('form').reset(); d.showModal();">
        Entrar
      </button>
      <dialog id="dialog-abrir-<%= m.mesaid %>"
        class="fixed inset-0 m-auto h-fit w-full max-w-sm rounded-lg shadow-lg p-0 border-0 backdrop:bg-slate-900/50">
        <form method="POST" action="/mesas/<%= m.mesaid %>/abrir" class="p-5 flex flex-col gap-3">
          <h2 class="text-sm font-bold text-slate-800">Abrir <%= m.nomesa %></h2>
          <input type="text" name="nombrecuenta" required autofocus placeholder="Nombre de la cuenta"
            class="border border-slate-300 rounded-md px-3 py-2 text-sm">
          <div class="flex justify-end gap-2 mt-1">
            <button type="button" onclick="this.closest('dialog').close()"
              class="text-slate-600 hover:bg-slate-100 text-sm font-medium rounded-md px-3 py-2">
              Cancelar
            </button>
            <button type="submit" class="bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium rounded-md px-3 py-2">
              Abrir
            </button>
          </div>
        </form>
      </dialog>
    <% } else if (m.estado === 'mia') { %>
      <a href="/mesas/<%= m.mesaid %>/cuentas"
        class="bg-sky-600 hover:bg-sky-700 text-white text-xs font-medium rounded px-3 py-1.5">
        Entrar
      </a>
    <% } else { %>
      <button type="button" disabled
        class="bg-slate-400 text-white text-xs font-medium rounded px-3 py-1.5 cursor-not-allowed">
        Ocupada
      </button>
    <% } %>
  </div>
</article>
