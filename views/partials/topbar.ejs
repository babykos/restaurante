<header class="fixed top-0 inset-x-0 h-16 z-50 bg-slate-900 text-white flex items-center gap-4 px-4">
  <button type="button" id="btn-toggle-sidebar" aria-label="Menú"
    class="text-white text-lg px-2 py-1 opacity-80 hover:opacity-100">
    <i class="fa-solid fa-bars"></i>
  </button>
  <a href="/mesas" class="flex items-center">
    <img src="/images/logo-codebytes.png" alt="CODEBYTES" class="h-11">
  </a>
  <div class="flex-1"></div>
  <div class="flex items-center gap-2 text-sm">
    <i class="fa-solid fa-circle-user text-xl text-slate-300"></i>
    <span><%= user.usuario %></span>
    <form method="POST" action="/logout">
      <button type="submit" title="Salir" class="text-white/80 hover:text-white px-2">
        <i class="fa-solid fa-right-from-bracket"></i>
      </button>
    </form>
  </div>
</header>
